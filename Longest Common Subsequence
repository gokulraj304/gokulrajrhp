class Solution {
    public int longestCommonSubsequence(String text1, String text2) {
        int r=text1.length();
        int l=text2.length();
        int[][] dp=new int[r+1][l+1];
        for(int i=1;i<=r;i++){
            for(int j=1;j<=l;j++){
                if(text1.charAt(i-1)==text2.charAt(j-1)){
                    dp[i][j]=dp[i-1][j-1]+1;
                }
                else{
                    dp[i][j]=Math.max(dp[i][j-1],dp[i-1][j]);
                }
            }
        }
        return dp[r][l];
    }
}
