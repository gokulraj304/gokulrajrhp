import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int[] arr=new int[n];
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
        }
        int[] prev=new int[n+1];
        long sum=0,lsum=0;
        for(int i=n-1;i>=0;i--){
            lsum-=prev[arr[i]];
            lsum+=n-i;
            prev[arr[i]]=n-i;
            sum+=lsum;
        }
        System.out.println(sum);
    }
}
