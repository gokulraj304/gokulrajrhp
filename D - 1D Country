#include <iostream>
#include <algorithm>
using namespace std;
int main(){
    int n;
    cin>>n;
    int loc[n];
    long long peo[n+1];
    for(int i=0;i<n;i++){
        cin>>loc[i];
    }
    peo[0]=0;
    for(int i=1;i<=n;i++){
        cin>>peo[i];
        peo[i]=peo[i-1]+peo[i];
    }
    int m;
    cin>>m;
    for(int i=0;i<m;i++){
        int a,b;
        cin>>a>>b;
        int it1=lower_bound(loc,loc+n,a)-loc;
        int it2=upper_bound(loc,loc+n,b)-loc;
        cout<<peo[it2]-peo[it1]<<endl;
    }
}
