import java.util.*;
public class Main
{
	public static void main(String[] args) {
Scanner sc=new Scanner(System.in);
int n=sc.nextInt();
int m=sc.nextInt();
int[] res=new int[n+2];
int y=m;
while(m>0){
    m--;
    int l=sc.nextInt();
    int r=sc.nextInt();
    res[l]++;
    res[r+1]--;
}
int mini=y;
for(int i=1;i<=n;i++){
    res[i]+=res[i-1];
    mini=Math.min(mini,res[i]);
}
System.out.println(mini);
	}
}
