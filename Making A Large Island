import java.util.*;

class Solution {

    int n;
    int[] dr = {-1, 1, 0, 0};
    int[] dc = {0, 0, -1, 1};

    public int largestIsland(int[][] grid) {

        n = grid.length;

        HashMap<Integer, Integer> area = new HashMap<>();

        int id = 2;
        int ans = 0;

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {

                if (grid[i][j] == 1) {

                    int size = dfs(grid, i, j, id);

                    area.put(id, size);

                    ans = Math.max(ans, size);

                    id++;
                }
            }
        }

        for (int i = 0; i < n; i++) {

            for (int j = 0; j < n; j++) {

                if (grid[i][j] == 0) {

                    HashSet<Integer> set = new HashSet<>();

                    int cur = 1;

                    for (int k = 0; k < 4; k++) {

                        int nr = i + dr[k];
                        int nc = j + dc[k];

                        if (nr < 0 || nc < 0 || nr >= n || nc >= n)
                            continue;

                        int islandId = grid[nr][nc];

                        if (islandId > 1 && !set.contains(islandId)) {

                            cur += area.get(islandId);

                            set.add(islandId);
                        }
                    }

                    ans = Math.max(ans, cur);
                }
            }
        }

        return ans;
    }

    private int dfs(int[][] grid, int r, int c, int id) {

        if (r < 0 || c < 0 || r >= n || c >= n)
            return 0;

        if (grid[r][c] != 1)
            return 0;

        grid[r][c] = id;

        int size = 1;

        for (int k = 0; k < 4; k++) {

            size += dfs(grid, r + dr[k], c + dc[k], id);
        }

        return size;
    }
}
